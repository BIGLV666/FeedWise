<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.feedwise</groupId>
    <artifactId>feedwise</artifactId>
    <version>0.1.0</version>
    <name>feedwise</name>
    <description>企业报销软件用户反馈与功能改进助手（全家桶整合 Demo）</description>

    <properties>
        <java.version>21</java.version>
        <mp.version>3.5.5</mp.version>
        <!-- 全家桶消费策略：JitPack 锁最新 commit（迭代），Maven Central 只发大版本。
             SHA 对应 2026-09-27 推送的各仓库 main 最新提交。 -->
        <jitpack.sha.auth-kit>3dab4767a9ec0a17b9a1cb90417a4762dd0cdd8f</jitpack.sha.auth-kit>
        <jitpack.sha.api-governance>401bb6c2ca1181f1ca69612f71d8f3227e1a7344</jitpack.sha.api-governance>
        <jitpack.sha.guard>e9942e36fbffb5e3912816959619e3e14656e80d</jitpack.sha.guard>
        <jitpack.sha.web-common>7465cf62ca7432b4c160d5c53d77d41de1c48bb9</jitpack.sha.web-common>
        <jitpack.sha.state-kit>53eaec6824cb15957321dbcaa2a56aaa49253321</jitpack.sha.state-kit>
        <jitpack.sha.outboxpro>d7b42229111cd885728b974f87180ad9e44beb15</jitpack.sha.outboxpro>
        <jitpack.sha.cache-kit>bd068856b9ea25c0057fa625db878d037e57dbd9</jitpack.sha.cache-kit>
        <jitpack.sha.data-scope>4c076c2e828cede7cb07e868a48f418eb1e1f301</jitpack.sha.data-scope>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ══════════ biglv666 全家桶（JitPack 锁 SHA） ══════════ -->
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>web-common-spring-boot-starter</artifactId>
            <version>${jitpack.sha.web-common}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>auth-kit-spring-boot-starter</artifactId>
            <version>${jitpack.sha.auth-kit}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>api-governance-spring-boot-starter</artifactId>
            <version>${jitpack.sha.api-governance}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>concurrent-guard</artifactId>
            <version>${jitpack.sha.guard}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>state-kit-spring-boot-starter</artifactId>
            <version>${jitpack.sha.state-kit}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>cache-kit-spring-boot-starter</artifactId>
            <version>${jitpack.sha.cache-kit}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>data-scope-spring-boot-starter</artifactId>
            <version>${jitpack.sha.data-scope}</version>
        </dependency>
        <!-- guard 分布式锁/编程式锁按类路径懒装配，Redisson 为 optional 需自加 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.27.2</version>
        </dependency>
        <!-- cache-kit binlog 直连失效为 optional 依赖，启用需自加（0.31.0 兼容 MySQL 8.4） -->
        <dependency>
            <groupId>com.zendesk</groupId>
            <artifactId>mysql-binlog-connector-java</artifactId>
            <version>0.31.0</version>
        </dependency>

        <!-- OutboxPro 为多模块仓库，JitPack 坐标 group 带仓库名 -->
        <dependency>
            <groupId>com.github.BIGLV666.OutboxPro</groupId>
            <artifactId>outboxpro-spring-boot-starter</artifactId>
            <version>${jitpack.sha.outboxpro}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
