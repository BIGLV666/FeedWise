<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.feedwise</groupId>
    <artifactId>feedwise</artifactId>
    <version>0.1.0</version>
    <name>feedwise</name>
    <description>企业报销软件用户反馈与功能改进助手（全家桶整合 Demo）</description>

    <properties>
        <java.version>21</java.version>
        <mp.version>3.5.5</mp.version>
        <!-- 全家桶消费策略：JitPack 锁最新 commit（迭代），Maven Central 只发大版本。
             SHA 对应 2026-09-27 推送的各仓库 main 最新提交。 -->
        <jitpack.sha.auth-kit>3dab4767a9ec0a17b9a1cb90417a4762dd0cdd8f</jitpack.sha.auth-kit>
        <jitpack.sha.api-governance>ed7634f5594863f9816b0cd11472bdb2dea69599</jitpack.sha.api-governance>
        <jitpack.sha.guard>7085fdcf98495b7094f1b1fb4b81857c67d651b5</jitpack.sha.guard>
        <jitpack.sha.web-common>b279da8ae51d02e638659daafe00e0f21962b929</jitpack.sha.web-common>
        <jitpack.sha.state-kit>ffa09ac64783f0acb4904c88a788bcc2f0ff7473</jitpack.sha.state-kit>
        <jitpack.sha.outboxpro>dca3e54c0d77a9e7b68bab3e3b4ecb1690901eb9</jitpack.sha.outboxpro>
        <jitpack.sha.cache-kit>8ec3135d5764184e067aa9a9f8076bac2077c022</jitpack.sha.cache-kit>
        <jitpack.sha.data-scope>4c076c2e828cede7cb07e868a48f418eb1e1f301</jitpack.sha.data-scope>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ══════════ biglv666 全家桶（JitPack 锁 SHA） ══════════ -->
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>web-common-spring-boot-starter</artifactId>
            <version>${jitpack.sha.web-common}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>auth-kit-spring-boot-starter</artifactId>
            <version>${jitpack.sha.auth-kit}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>api-governance-spring-boot-starter</artifactId>
            <version>${jitpack.sha.api-governance}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>concurrent-guard</artifactId>
            <version>${jitpack.sha.guard}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>state-kit-spring-boot-starter</artifactId>
            <version>${jitpack.sha.state-kit}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>cache-kit-spring-boot-starter</artifactId>
            <version>${jitpack.sha.cache-kit}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BIGLV666</groupId>
            <artifactId>data-scope-spring-boot-starter</artifactId>
            <version>${jitpack.sha.data-scope}</version>
        </dependency>
        <!-- OutboxPro 为多模块仓库，JitPack 坐标 group 带仓库名 -->
        <dependency>
            <groupId>com.github.BIGLV666.OutboxPro</groupId>
            <artifactId>outboxpro-spring-boot-starter</artifactId>
            <version>${jitpack.sha.outboxpro}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
